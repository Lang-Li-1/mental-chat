# ============================================================================
# 心理守护平台 — 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================================

# ── Django Backend ──────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mental_chat
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=postgres
DB_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── AI Service ──────────────────────────────────────────────────────────────
AI_API_KEY=your-qwen-api-key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_MODEL=qwen-plus
AI_SERVICE_URL=http://ai_service:5000/respond
AI_SERVICE_TIMEOUT=30

# ── CORS (production) ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com
